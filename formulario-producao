window.addEventListener('click', e => {
  if (!e.target.closest('.search-wrap')) closeAllDropdowns();
});

function setHoraInicio() {
  horaInicio = new Date().toLocaleTimeString('pt-BR', {hour:'2-digit',minute:'2-digit'});
}

function maskHora(el) {
  let v = el.value.replace(/\D/g,'');
  if (v.length >= 3) v = v.slice(0,2) + ':' + v.slice(2,4);
  el.value = v;
}

// ── TABS ──
function switchTab(t, btn) {
  document.querySelectorAll('.tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('tab-form').style.display = t==='form' ? 'block' : 'none';
  document.getElementById('tab-records').style.display = t==='records' ? 'block' : 'none';
}

// ── DROPDOWN SEARCH ──
function openDropdown(id) {
  if (id === 'dd-produto') {
    renderProdutosDropdown(document.getElementById('inp-produto').value);
    document.getElementById('dd-produto').classList.add('open');
  } else if (id === 'dd-modulacao' && selectedProduto) {
    renderModulacoesDropdown(document.getElementById('inp-modulacao').value);
    document.getElementById('dd-modulacao').classList.add('open');
  }
}

function closeAllDropdowns() {
  document.querySelectorAll('.dropdown').forEach(d => d.classList.remove('open'));
}

function renderProdutosDropdown(q) {
  const dd = document.getElementById('dd-produto');
  const filtered = q.length < 1
    ? produtos.slice(0, 80)
    : produtos.filter(p => p.includes(q.toUpperCase()) || DB[p].cod.includes(q));
  if (!filtered.length) {
    dd.innerHTML = '<div class="dd-empty">Nenhum modelo encontrado</div>';
    return;
  }
  dd.innerHTML = filtered.map(p => `
    <div class="dd-item" onclick="selectProduto('${p}')">
      <span>${p.replace('MODELO ','').replace('MODELO ','').split(' ').map(w=>w[0]+w.slice(1).toLowerCase()).join(' ')}</span>
      <span class="dd-sub">${DB[p].cod}</span>
    </div>
  `).join('');
}

function filterProdutos(q) {
  renderProdutosDropdown(q.toUpperCase());
  document.getElementById('dd-produto').classList.add('open');
}

function selectProduto(nome) {
  selectedProduto = nome;
  selectedModulacao = null;
  const label = nome.replace('MODELO ','').split(' ').map(w=>w[0]+w.slice(1).toLowerCase()).join(' ');
  document.getElementById('inp-produto').value = '';
  document.getElementById('inp-produto').placeholder = label + ' (' + DB[nome].cod + ')';
  document.getElementById('sel-produto-text').innerHTML = label + '<span class="cod-badge">' + DB[nome].cod + '</span>';
  document.getElementById('sel-produto-display').style.display = 'block';
  const cols = DB[nome].colecoes;
  const hint = document.getElementById('hint-produto');
  if (cols.length) {
    hint.textContent = 'Coleção: ' + cols.join(', ');
    hint.classList.add('show');
  } else hint.classList.remove('show');
  const inpMod = document.getElementById('inp-modulacao');
  inpMod.disabled = false;
  inpMod.placeholder = 'Buscar modulação...';
  inpMod.value = '';
  document.getElementById('sel-modulacao-display').style.display = 'none';
  closeAllDropdowns();
}

function clearProduto() {
  selectedProduto = null;
  selectedModulacao = null;
  document.getElementById('inp-produto').value = '';
  document.getElementById('inp-produto').placeholder = 'Digite o nome ou código do modelo...';
  document.getElementById('sel-produto-display').style.display = 'none';
  document.getElementById('hint-produto').classList.remove('show');
  const inpMod = document.getElementById('inp-modulacao');
  inpMod.disabled = true;
  inpMod.placeholder = 'Selecione o modelo primeiro...';
  inpMod.value = '';
  document.getElementById('sel-modulacao-display').style.display = 'none';
}

function renderModulacoesDropdown(q) {
  if (!selectedProduto) return;
  const dd = document.getElementById('dd-modulacao');
  const mods = DB[selectedProduto].modulacoes;
  const filtered = q.length < 1 ? mods : mods.filter(m => m.toUpperCase().includes(q.toUpperCase()));
  if (!filtered.length) {
    dd.innerHTML = '<div class="dd-empty">Nenhuma modulação encontrada</div>';
    return;
  }
  dd.innerHTML = filtered.map(m => `
    <div class="dd-item" onclick="selectModulacao('${m.replace(/'/g, "\'")}')">
      <span>${m}</span>
    </div>
  `).join('');
}

function filterModulacoes(q) {
  if (!selectedProduto) return;
  renderModulacoesDropdown(q);
  document.getElementById('dd-modulacao').classList.add('open');
}

function selectModulacao(nome) {
  selectedModulacao = nome;
  document.getElementById('inp-modulacao').value = '';
  document.getElementById('inp-modulacao').placeholder = nome;
  document.getElementById('sel-modulacao-text').textContent = nome;
  document.getElementById('sel-modulacao-display').style.display = 'block';
  closeAllDropdowns();
}

function clearModulacao() {
  selectedModulacao = null;
  document.getElementById('inp-modulacao').value = '';
  document.getElementById('inp-modulacao').placeholder = 'Buscar modulação...';
  document.getElementById('sel-modulacao-display').style.display = 'none';
}

// ── CHIPS ──
function selectChip(el, group) {
  document.querySelectorAll('#' + group + ' .chip').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
}

function getChip(group) {
  const sel = document.querySelector('#' + group + ' .chip.selected');
  return sel ? sel.dataset.val : '';
}

// ── NAVIGATION ──
function setProgress(step) {
  [1,2,3].forEach(i => {
    const el = document.getElementById('p' + i);
    el.className = 'prog-step' + (i < step ? ' done' : i === step ? ' active' : '');
  });
}

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function goTo1() { showScreen('sc1'); setProgress(1); }

function goTo2() {
