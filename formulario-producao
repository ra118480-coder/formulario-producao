  const data = document.getElementById('inp-data').value;
  const horaFim = document.getElementById('inp-hora-fim').value;
  if (!setor) return showNotify('Selecione o setor.', 'error');
  if (!versao) return showNotify('Selecione a versão.', 'error');
  if (!desc) return showNotify('Preencha a descrição.', 'error');
  if (!data) return showNotify('Informe a data.', 'error');
  if (!horaFim) return showNotify('Informe a hora de conclusão.', 'error');

  const label = selectedProduto.replace('MODELO ','').split(' ').map(w=>w[0]+w.slice(1).toLowerCase()).join(' ');
  const melhoria = document.getElementById('sel-melhoria').value || 'Nenhuma';
  const rows = [
    ['Modelo', label + ' (' + DB[selectedProduto].cod + ')'],
    ['Modulação', selectedModulacao],
    ['Setor', setor],
    ['Versão', versao],
    ['Tipo de Melhoria', melhoria],
    ['Data', data],
    ['Hora Início', horaInicio],
    ['Hora Conclusão', horaFim],
    ['Descrição', desc],
  ];
  document.getElementById('summary-card').innerHTML = rows.map(([k,v]) =>
    `<div class="summary-row"><div class="sk">${k}</div><div class="sv">${v}</div></div>`
  ).join('');
  showScreen('sc3'); setProgress(3);
}

function submitForm() {
  const rec = {
    id: records.length + 1,
    modelo: selectedProduto,
    cod: DB[selectedProduto].cod,
    modulacao: selectedModulacao,
    setor: getChip('chip-setor'),
    versao: document.getElementById('sel-versao').value,
    melhoria: document.getElementById('sel-melhoria').value || 'Nenhuma',
    data: document.getElementById('inp-data').value,
    hora_inicio: horaInicio,
    hora_conclusao: document.getElementById('inp-hora-fim').value,
    descricao: document.getElementById('inp-descricao').value.trim(),
    salvo_em: new Date().toLocaleString('pt-BR')
  };
  records.push(rec);
  document.getElementById('rec-count').textContent = records.length;
  renderRecords();
  showScreen('scOK');
  setProgress(3);
}

function newForm() {
  clearProduto();
  document.querySelectorAll('.chip.selected').forEach(c => c.classList.remove('selected'));
  document.getElementById('sel-versao').value = '';
  document.getElementById('sel-melhoria').value = '';
  document.getElementById('inp-descricao').value = '';
  document.getElementById('inp-hora-fim').value = '';
  document.getElementById('inp-data').value = new Date().toISOString().split('T')[0];
  setHoraInicio();
  goTo1();
}

function renderRecords() {
  const list = document.getElementById('records-list');
  const sub = document.getElementById('rec-subtitle');
  if (!records.length) { list.innerHTML=''; sub.textContent='Nenhum registro ainda.'; return; }
  sub.textContent = records.length + ' registro(s) nesta sessão.';
  list.innerHTML = records.slice().reverse().map(r => `
    <div class="rec-item">
      <div>
        <div class="rec-main">${r.modelo.replace('MODELO ','').split(' ').map(w=>w[0]+w.slice(1).toLowerCase()).join(' ')} — ${r.modulacao}</div>
        <div class="rec-sub">Setor: ${r.setor} | ${r.versao} | ${r.melhoria}</div>
      </div>
      <div class="rec-time">${r.data}<br>${r.hora_inicio} → ${r.hora_conclusao}</div>
    </div>
  `).join('');
}

function exportCSV() {
  if (!records.length) return showNotify('Nenhum registro para exportar.', 'error');
  const heads = ['ID','Código','Modelo','Modulação','Setor','Versão','Tipo Melhoria','Data','Hora Início','Hora Conclusão','Descrição','Salvo em'];
  const rows = records.map(r => [
    r.id, r.cod, r.modelo, r.modulacao, r.setor, r.versao, r.melhoria,
    r.data, r.hora_inicio, r.hora_conclusao,
    '"' + r.descricao.replace(/"/g,'""') + '"',
    r.salvo_em
  ].join(','));
  const csv = [heads.join(','), ...rows].join('\n');
  const blob = new Blob(['\uFEFF' + csv], {type:'text/csv;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'registros_producao_' + new Date().toISOString().slice(0,10) + '.csv';
  a.click();
  showNotify('CSV exportado com sucesso!', 'success');
}

function showNotify(msg, type) {
  const el = document.getElementById('notify');
  el.textContent = msg;
  el.className = 'notify ' + type;
  el.style.display = 'block';
  setTimeout(() => el.style.display = 'none', 3000);
}

// Init dropdown
renderProdutosDropdown('');
</script>
